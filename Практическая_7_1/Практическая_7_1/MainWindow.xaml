<Window x:Class="Практическая_7_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая 7.1 - Космос" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <!-- Используем Grid (сетку) для расположения элементов -->
    <Grid Margin="20">
        <!-- Определяем две строки: одна для текста, другая для кнопки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Текст с мифом -->
        <TextBlock x:Name="txtMyth" 
                   Grid.Row="0" 
                   Foreground="White" 
                   FontSize="18" 
                   TextWrapping="Wrap" 
                   TextAlignment="Center" 
                   VerticalAlignment="Center"
                   Text="Нажмите кнопку, чтобы отправиться в полет и узнать миф о космосе!"/>

        <!-- Кнопка запуска -->
        <Button x:Name="btnLaunch" 
                Grid.Row="1" 
                Content="🚀 Запустить полет" 
                Width="200" 
                Height="50" 
                FontSize="16" 
                Background="#4CAF50" 
                Foreground="White" 
                BorderThickness="0"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Click="btnLaunch_Click"/>
    </Grid>
</Window>